# Copy to .env, then restart Metro with `npx expo start -c` — Expo inlines
# EXPO_PUBLIC_* at build time, so a warm bundler will not pick up changes.
#
# Leave this UNSET to run the whole app on the mock catalogue in lib/data.ts.
# That is a supported mode: every screen renders standalone until Laravel is up.
#
#   Android emulator ....... http://localhost:8000/api  (rewritten to 10.0.2.2)
#   iOS simulator .......... http://localhost:8000/api
#   Physical device ........ http://<your-machine-LAN-IP>:8000/api
#
# A phone cannot reach "localhost" on your laptop — that address means the
# phone itself. Use the LAN IP and serve Laravel on it:
#   php artisan serve --host=0.0.0.0 --port=8000
EXPO_PUBLIC_API_URL=

# The app's own client key. The API gates its public endpoints on this and
# answers 401 without it. Must match API_CLIENT_KEY_MOBILE in backend/.env —
# never the web key, or revoking a leaked mobile key takes the site down too.
# It ships inside the binary and is extractable: it buys attribution and rate
# limiting, not secrecy.
EXPO_PUBLIC_API_CLIENT_KEY=
